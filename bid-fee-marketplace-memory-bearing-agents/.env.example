# ============================================================
# bid-fee-marketplace-memory-bearing-agents  —  ENV TEMPLATE
# Copy this file to .env.local and fill in real values.
# NEVER commit .env or .env.local (see .gitignore).
# ============================================================

# ---------- Supabase (DB + Auth + Realtime) ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Anthropic Claude (agent memory chat + auto-bidder) ----------
ANTHROPIC_API_KEY=

# ---------- Rain (stablecoin payment rails — SPONSOR) ----------
# Grab these from the Rain workshop / sandbox at the event.
RAIN_API_KEY=
RAIN_API_BASE_URL=
RAIN_WEBHOOK_SECRET=

# ---------- Monad (on-chain audit receipts — BOUNTY) ----------
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_MONAD_CHAIN_ID=
NEXT_PUBLIC_MONAD_EXPLORER_URL=
# Deployer / relayer key for writing AuctionRegistry receipts. Server-only.
MONAD_DEPLOYER_PRIVATE_KEY=
NEXT_PUBLIC_AUCTION_REGISTRY_ADDRESS=

# ---------- App ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
