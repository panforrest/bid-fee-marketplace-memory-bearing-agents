# ============================================================
# bid-fee-marketplace-memory-bearing-agents  —  ENV TEMPLATE
# Copy this file to .env.local and fill in real values.
# NEVER commit .env or .env.local (see .gitignore).
# ============================================================

# ---------- Supabase (DB + Auth + Realtime) ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Anthropic Claude (agent memory chat + auto-bidder) ----------
ANTHROPIC_API_KEY=

# ---------- Rain (stablecoin payment rails — SPONSOR) ----------
# Grab these from the Rain workshop / sandbox at the event.
# If RAIN_API_KEY is unset, the app uses a faithful simulated Rain rail
# (clearly labelled) so the demo never breaks. Set the key to go live.
RAIN_API_KEY=
RAIN_API_BASE_URL=
RAIN_ACCOUNT_ID=
RAIN_USER_ID=
RAIN_WEBHOOK_SECRET=
# USDC treasury/destination the marketplace settles into (optional; sandbox).
RAIN_TREASURY_ADDRESS=

# ---------- Monad (on-chain audit receipts — BOUNTY) ----------
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_MONAD_CHAIN_ID=
NEXT_PUBLIC_MONAD_EXPLORER_URL=
# Deployer / relayer key for writing AuctionRegistry receipts. Server-only.
MONAD_DEPLOYER_PRIVATE_KEY=
NEXT_PUBLIC_AUCTION_REGISTRY_ADDRESS=

# ---------- Monad — REAL per-bid MON transfers (the money-shot) ----------
# Each bidder is mapped to a funded Monad testnet wallet. On every bid, that
# bidder's wallet sends BID_MON_AMOUNT of native MON to SELLER_ADDRESS — so the
# bidder's balance goes DOWN and the seller's goes UP, live and verifiable.
# If a bidder's private key is unset, that bidder's transfer is SIMULATED
# (0xsim_...) so the demo never hard-fails. NEVER commit real keys.
#
# Bidder 1 (default address matches the app's guest URL param).
BIDDER1_PRIVATE_KEY=
BIDDER1_ADDRESS=0x0B58561F2325F9eAB95Ce6cCE5981255D82bc50b
# Bidder 2 (default address matches the app's guest URL param).
BIDDER2_PRIVATE_KEY=
BIDDER2_ADDRESS=0x77dDCFDbD24a04BC150bc5d7EA636c0c990936bd
# Receiver of every bid fee (the seller / auctioneer). If unset, falls back to
# the address derived from MONAD_DEPLOYER_PRIVATE_KEY.
SELLER_ADDRESS=
# Native MON sent per bid (string, in MON).
BID_MON_AMOUNT=0.05

# ---------- App ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
